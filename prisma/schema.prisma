generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          Role           @default(ATTENDEE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  organizations Organization[]
  tickets       Ticket[]
  holds         TicketHold[]

  @@index([email])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([slug])
}

model Event {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  slug           String       @unique
  description    String
  category       String
  venue          String
  city           String
  startAt        DateTime
  endAt          DateTime
  salesStartAt   DateTime
  salesCutoffAt  DateTime
  status         EventStatus  @default(DRAFT)
  coverImage     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         Order[]
  holds          TicketHold[]
  ticketTiers    TicketTier[]

  @@index([organizationId])
  @@index([category])
  @@index([city])
  @@index([startAt])
  @@index([status])
}

model TicketTier {
  id               String           @id @default(uuid())
  eventId          String
  name             String
  description      String?
  price            Int
  currency         String           @default("INR")
  totalQuantity    Int
  soldQuantity     Int              @default(0)
  reservedQuantity Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  orderItems       OrderItem[]
  tickets          Ticket[]
  holdItems        TicketHoldItem[]
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model TicketHold {
  id        String           @id @default(uuid())
  userId    String
  eventId   String
  status    HoldStatus       @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  order     Order?
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     TicketHoldItem[]

  @@index([userId])
  @@index([status, expiresAt])
  @@index([eventId])
}

model TicketHoldItem {
  id           String     @id @default(uuid())
  holdId       String
  ticketTierId String
  quantity     Int
  unitPrice    Int
  hold         TicketHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  ticketTier   TicketTier @relation(fields: [ticketTierId], references: [id], onDelete: Cascade)

  @@index([holdId])
  @@index([ticketTierId])
}

model Order {
  id             String               @id @default(uuid())
  orderNumber    String               @unique
  userId         String
  eventId        String
  holdId         String?              @unique
  status         OrderStatus          @default(PENDING)
  totalAmount    Int
  currency       String               @default("INR")
  idempotencyKey String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  event          Event                @relation(fields: [eventId], references: [id])
  hold           TicketHold?          @relation(fields: [holdId], references: [id])
  user           User                 @relation(fields: [userId], references: [id])
  items          OrderItem[]
  transactions   PaymentTransaction[]

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  ticketTierId String
  quantity     Int
  unitPrice    Int
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier   TicketTier @relation(fields: [ticketTierId], references: [id])
  tickets      Ticket[]

  @@index([orderId])
  @@index([ticketTierId])
}

model PaymentTransaction {
  id               String        @id @default(uuid())
  orderId          String
  paymentReference String        @unique
  idempotencyKey   String?       @unique
  amount           Int
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  gatewayResponse  String?
  createdAt        DateTime      @default(now())
  processedAt      DateTime?
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentReference])
}

model Ticket {
  id                String       @id @default(uuid())
  orderItemId       String
  ticketTierId      String
  userId            String
  verificationToken String       @unique
  status            TicketStatus @default(VALID)
  issuedAt          DateTime     @default(now())
  usedAt            DateTime?
  orderItem         OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ticketTier        TicketTier   @relation(fields: [ticketTierId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([ticketTierId])
  @@index([userId])
  @@index([verificationToken])
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum HoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  RELEASED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}
